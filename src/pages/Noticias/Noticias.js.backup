const newsItems = [
  {
    slug: "novo-ano-escolar",
    title: "Novo ano escolar",
    date: "01 de Setembro de 2026",
    category: "Vida escolar",
    image: "https://images.pexels.com/photos/256520/pexels-photo-256520.jpeg?auto=compress&cs=tinysrgb&w=1200",
    description: "Informação de exemplo sobre o início de um novo período escolar e os momentos que marcam a vida da comunidade Santa Albertina."
  },
  {
    slug: "aprendizagem-em-destaque",
    title: "Aprendizagem em destaque",
    date: "05 de Setembro de 2026",
    category: "Académico",
    image: "https://images.pexels.com/photos/4145190/pexels-photo-4145190.jpeg?auto=compress&cs=tinysrgb&w=1200",
    description: "Conteúdo de exemplo para representar uma publicação relacionada com aprendizagem, conhecimento e desenvolvimento académico."
  },
  {
    slug: "momentos-da-comunidade",
    title: "Momentos da comunidade",
    date: "10 de Setembro de 2026",
    category: "Comunidade",
    image: "https://images.pexels.com/photos/1181406/pexels-photo-1181406.jpeg?auto=compress&cs=tinysrgb&w=1200",
    description: "Publicação de exemplo sobre momentos e experiências que fazem parte da comunidade escolar."
  },
  {
    slug: "conhecimento-e-futuro",
    title: "Conhecimento e futuro",
    date: "15 de Setembro de 2026",
    category: "Educação",
    image: "https://images.pexels.com/photos/11000394/pexels-photo-11000394.jpeg?auto=compress&cs=tinysrgb&w=1200",
    description: "Notícia de exemplo sobre educação, conhecimento e preparação para novos desafios."
  }
];

export function Noticias() {
  return `
    <div class="news-page">

      <section class="news-hero">
        <div class="news-hero__image">

          <img
            src="https://cdn.pixabay.com/photo/2015/07/31/11/45/library-869061_1280.jpg"
            alt="Imagem conceptual relacionada com notícias e conhecimento"
          />

          <div
            class="news-hero__overlay"
            aria-hidden="true"
          ></div>

          <div class="news-hero__container container">
            <div class="news-hero__content">

              <span class="news-hero__eyebrow">
                Notícias
              </span>

              <h1 class="news-hero__title">
                Informação que aproxima
                <span>a comunidade escolar.</span>
              </h1>

              <p class="news-hero__description">
                Acompanhe as principais notícias, informações
                e acontecimentos da Santa Albertina.
              </p>

            </div>
          </div>

        </div>
      </section>

      <section class="news-list section">

        <div class="news-list__container container">

          <div class="news-list__heading">

            <span class="section__eyebrow">
              Publicações
            </span>

            <h2>
              Notícias da Santa Albertina
            </h2>

            <p>
              Explore as notícias e informações publicadas
              pela comunidade escolar.
            </p>

          </div>

          <div class="news-grid">

            ${newsItems.map((news, index) => `
              <a
                href="/noticias/${news.slug}"
                data-route
                class="news-card"
                aria-label="Ler notícia: ${news.title}"
              >

                <div class="news-card__image">
                  <img
                    src="${news.image}"
                    alt="${news.title}"
                  />
                </div>

                <div class="news-card__content">

                  <span class="news-card__category">
                    ${news.category}
                  </span>

                  <h3>
                    ${news.title}
                  </h3>

                  <span class="news-card__date">
                    ${news.date}
                  </span>

                </div>

              </a>
            `).join("")}

          </div>

        </div>

      </section>

      <div
        class="news-lightbox"
        id="news-lightbox"
        aria-hidden="true"
      >

        <button
          class="news-lightbox__backdrop"
          type="button"
          aria-label="Fechar notícia"
          onclick="window.closeSchoolNews()"
        ></button>

        <button
          class="news-lightbox__close"
          type="button"
          aria-label="Fechar notícia"
          onclick="window.closeSchoolNews()"
        >
          ×
        </button>

        <button
          class="news-lightbox__previous"
          type="button"
          aria-label="Notícia anterior"
          onclick="window.previousSchoolNews()"
        >
          ‹
        </button>

        <article class="news-lightbox__content">

          <div class="news-lightbox__image">
            <img
              id="news-lightbox-image"
              src=""
              alt=""
            />
          </div>

          <div class="news-lightbox__body">

            <span
              id="news-lightbox-category"
              class="news-lightbox__category"
            ></span>

            <h2 id="news-lightbox-title"></h2>

            <span
              id="news-lightbox-date"
              class="news-lightbox__date"
            ></span>

            <p id="news-lightbox-description"></p>

            <span
              id="news-lightbox-counter"
              class="news-lightbox__counter"
            ></span>

          </div>

        </article>

        <button
          class="news-lightbox__next"
          type="button"
          aria-label="Próxima notícia"
          onclick="window.nextSchoolNews()"
        >
          ›
        </button>

      </div>

    </div>
  `;
}

window.schoolNewsCurrentIndex = 0;

window.openSchoolNews = function(index) {

  const lightbox =
    document.querySelector("#news-lightbox");

  const image =
    document.querySelector("#news-lightbox-image");

  const category =
    document.querySelector("#news-lightbox-category");

  const title =
    document.querySelector("#news-lightbox-title");

  const date =
    document.querySelector("#news-lightbox-date");

  const description =
    document.querySelector("#news-lightbox-description");

  const counter =
    document.querySelector("#news-lightbox-counter");

  if (
    !lightbox ||
    !image ||
    !category ||
    !title ||
    !date ||
    !description ||
    !counter
  ) {
    return;
  }

  window.schoolNewsCurrentIndex =
    (Number(index) + newsItems.length) %
    newsItems.length;

  const current =
    newsItems[window.schoolNewsCurrentIndex];

  image.src = current.image;
  image.alt = current.title;

  category.textContent =
    current.category;

  title.textContent =
    current.title;

  date.textContent =
    current.date;

  description.textContent =
    current.description;

  counter.textContent =
    `${window.schoolNewsCurrentIndex + 1} / ${newsItems.length}`;

  lightbox.classList.add(
    "news-lightbox--open"
  );

  lightbox.setAttribute(
    "aria-hidden",
    "false"
  );

  document.body.classList.add(
    "news-lightbox-open"
  );
};

window.previousSchoolNews = function() {
  window.openSchoolNews(
    window.schoolNewsCurrentIndex - 1
  );
};

window.nextSchoolNews = function() {
  window.openSchoolNews(
    window.schoolNewsCurrentIndex + 1
  );
};

window.closeSchoolNews = function() {

  const lightbox =
    document.querySelector("#news-lightbox");

  const image =
    document.querySelector("#news-lightbox-image");

  if (!lightbox) {
    return;
  }

  lightbox.classList.remove(
    "news-lightbox--open"
  );

  lightbox.setAttribute(
    "aria-hidden",
    "true"
  );

  document.body.classList.remove(
    "news-lightbox-open"
  );

  if (image) {
    image.src = "";
    image.alt = "";
  }
};

document.addEventListener("keydown", (event) => {

  const lightbox =
    document.querySelector("#news-lightbox");

  if (
    !lightbox ||
    !lightbox.classList.contains(
      "news-lightbox--open"
    )
  ) {
    return;
  }

  if (event.key === "Escape") {
    window.closeSchoolNews();
  }

  if (event.key === "ArrowLeft") {
    window.previousSchoolNews();
  }

  if (event.key === "ArrowRight") {
    window.nextSchoolNews();
  }
});
