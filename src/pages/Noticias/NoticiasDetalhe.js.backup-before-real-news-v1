function getNewsBySlug(slug) {
  return newsItems.find((news) => news.slug === slug);
}

function getRelatedNews(currentSlug) {
  return newsItems
    .filter((news) => news.slug !== currentSlug)
    .slice(0, 3);
}

export function NoticiasDetalhe(slug) {
  const news = getNewsBySlug(slug);

  if (!news) {
    return `
      <section class="news-detail-not-found section">
        <div class="container">
          <span class="section__eyebrow">
            Notícias
          </span>

          <h1>Notícia não encontrada</h1>

          <p>
            A notícia que procura não está disponível.
          </p>

          <a
            href="/noticias"
            data-route
            class="button button--primary"
          >
            ← Voltar para Notícias
          </a>
        </div>
      </section>
    `;
  }

  const relatedNews = getRelatedNews(news.slug);

  return `
    <article class="news-detail">

      <section class="news-detail__hero">

        <div class="news-detail__hero-container container">

          <a
            href="/noticias"
            data-route
            class="news-detail__back"
          >
            <span aria-hidden="true">←</span>
            <span>Voltar para Notícias</span>
          </a>

          <div class="news-detail__meta">

            <span class="news-detail__category">
              ${news.category}
            </span>

            <time class="news-detail__date">
              ${news.date}
            </time>

          </div>

          <h1 class="news-detail__title">
            ${news.title}
          </h1>

          <p class="news-detail__summary">
            ${news.summary}
          </p>

        </div>

      </section>

      <section class="news-detail__main section">

        <div class="container">

          <figure class="news-detail__cover">

            <img
              src="${news.image}"
              alt="${news.title}"
            />

          </figure>

          <div class="news-detail__layout">

            <div class="news-detail__content">

              ${news.content}

            </div>

            <aside class="news-detail__aside">

              <span class="news-detail__aside-label">
                Publicado em
              </span>

              <time>
                ${news.date}
              </time>

              <a
                href="/noticias"
                data-route
                class="news-detail__aside-link"
              >
                ← Ver todas as notícias
              </a>

            </aside>

          </div>

        </div>

      </section>

      ${
        relatedNews.length
          ? `
            <section class="news-detail__related section">

              <div class="container">

                <div class="news-detail__related-heading">

                  <span class="section__eyebrow">
                    Continue a explorar
                  </span>

                  <h2>
                    Outras notícias
                  </h2>

                </div>

                <div class="news-detail__related-grid">

                  ${relatedNews.map((item) => `
                    <a
                      href="/noticias/${item.slug}"
                      data-route
                      class="news-detail__related-card"
                    >

                      <div class="news-detail__related-image">

                        <img
                          src="${item.image}"
                          alt="${item.title}"
                        />

                      </div>

                      <div class="news-detail__related-body">

                        <span>
                          ${item.category}
                        </span>

                        <h3>
                          ${item.title}
                        </h3>

                        <time>
                          ${item.date}
                        </time>

                      </div>

                    </a>
                  `).join("")}

                </div>

              </div>

            </section>
          `
          : ""
      }

    </article>
  `;
}
